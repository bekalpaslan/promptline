{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promptline",
  "version": "0.2.0",
  "identifier": "com.promptline.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Promptline",
        "url": "index.html",
        "width": 760,
        "height": 540,
        "minWidth": 560,
        "minHeight": 400,
        "center": true
      },
      {
        "label": "popup",
        "title": "Promptline",
        "url": "popup.html",
        "width": 400,
        "height": 460,
        "minWidth": 320,
        "minHeight": 280,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
