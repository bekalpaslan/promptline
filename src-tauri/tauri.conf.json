{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promptline",
  "version": "0.2.6",
  "identifier": "com.promptline.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Promptline",
        "url": "index.html",
        "width": 1000,
        "height": 800,
        "minWidth": 560,
        "minHeight": 400,
        "center": true
      },
      {
        "label": "popup",
        "title": "Promptline",
        "url": "popup.html",
        "width": 400,
        "height": 600,
        "minWidth": 320,
        "minHeight": 280,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
