{
  "name": "promptline",
  "version": "0.2.13",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "ui:dev": "vite",
    "ui:build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "design:build": "node scripts/tokens.mjs --shim design/dist/shim.css && vite build --config design/vite.config.ts && node scripts/design-pack.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/outfit": "^5.2.8",
    "@remixicon/react": "^4.9.0",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6",
    "typescript-eslint": "^8.70.0",
    "vite": "^8"
  }
}
